{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titancsa.github.io/integration.schema.json",
  "title": "TitanCSA Windows integration catalogue",
  "description": "Versioned download and first-check instructions for applications, drivers and SDK packages.",
  "type": "object",
  "required": ["$schema", "schema_version", "reviewed", "guides", "first_run_guides", "commercial_contact", "products", "applications", "sdk_registry", "starter_zip_url", "starter_zip_checksum_url", "project_catalogue_url", "source_repository"],
  "properties": {
    "$schema": { "const": "https://titancsa.github.io/integration.schema.json" },
    "schema_version": { "const": 1 },
    "reviewed": { "type": "string", "format": "date" },
    "guides": { "$ref": "#/$defs/guideUrls" },
    "first_run_guides": { "$ref": "#/$defs/guideUrls" },
    "project_catalogue_url": { "$ref": "#/$defs/url" },
    "starter_zip_url": { "$ref": "#/$defs/url" },
    "starter_zip_checksum_url": { "$ref": "#/$defs/url" },
    "source_repository": { "$ref": "#/$defs/url" },
    "commercial_contact": {
      "type": "object",
      "required": ["platform", "username", "contact_guide_url"],
      "properties": {
        "platform": { "const": "Discord" },
        "username": { "type": "string", "minLength": 1 },
        "contact_guide_url": { "$ref": "#/$defs/url" }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/driverProduct" }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/windowsApp" }
    },
    "sdk_registry": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registryPackage" }
    },
    "sdk_quickstarts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edition", "name", "language", "download_url", "release_url", "sha256", "command", "expected_output", "evidence_url"],
        "properties": {
          "edition": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "language": { "const": "Rust" },
          "download_url": { "$ref": "#/$defs/url" },
          "release_url": { "$ref": "#/$defs/url" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "command": { "const": "cargo run --locked" },
          "expected_output": { "type": ["object", "array"] },
          "evidence_url": { "$ref": "#/$defs/url" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["x64", "x86", "arm64"] }
    },
    "guideUrls": {
      "type": "object",
      "required": ["en", "fr"],
      "additionalProperties": { "$ref": "#/$defs/url" }
    },
    "localizedText": {
      "type": "object",
      "required": ["en", "fr"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "consoleSetup": {
      "type": "object",
      "required": ["asset_role", "archive_member", "installer_sha256", "requires_administrator", "install_arguments", "uninstall_arguments", "success_exit_codes", "restart_required_exit_code", "restart_before_check", "evidence_url"],
      "properties": {
        "asset_role": { "enum": ["console_installer", "archive"] },
        "archive_member": { "type": ["string", "null"] },
        "installer_sha256": { "$ref": "#/$defs/sha256" },
        "requires_administrator": { "const": true },
        "install_arguments": { "const": ["/install"] },
        "uninstall_arguments": { "const": ["/uninstall"] },
        "success_exit_codes": { "const": [0, 3010] },
        "restart_required_exit_code": { "const": 3010 },
        "restart_before_check": { "const": true },
        "evidence_url": { "$ref": "#/$defs/url" }
      }
    },
    "driverProduct": {
      "type": "object",
      "required": ["id", "name", "source", "overview_url", "demo", "sdk_check"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/url" },
        "overview_url": { "$ref": "#/$defs/url" },
        "commercial_install_verification": {
          "type": "object",
          "required": ["url", "package_version", "driver_version"],
          "properties": {
            "url": { "$ref": "#/$defs/url" },
            "package_version": { "type": "string" },
            "driver_version": { "type": "string" }
          }
        },
        "demo": {
          "type": "object",
          "required": ["version", "tag", "notes_url", "setup_download_url", "setup_download_sha256", "setup_format", "setup_member", "supported_driver_architecture", "trial_starts_on", "assets"],
          "properties": {
            "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){3}$" },
            "tag": { "type": "string", "minLength": 1 },
            "notes_url": { "$ref": "#/$defs/url" },
            "setup_download_url": { "$ref": "#/$defs/url" },
            "setup_download_sha256": { "$ref": "#/$defs/sha256" },
            "setup_format": { "enum": ["installer", "zip"] },
            "setup_member": { "type": ["string", "null"] },
            "supported_driver_architecture": { "enum": ["x64", "x86", "arm64"] },
            "trial_starts_on": { "type": "string", "minLength": 1 },
            "installer_verification_url": { "$ref": "#/$defs/url" },
            "mouse_driver_switch_verification_url": { "$ref": "#/$defs/url" },
            "console_setup": { "$ref": "#/$defs/consoleSetup" },
            "live_inventory_verification": {
              "type": "object",
              "required": ["url", "sample_source_url", "app_architectures", "opens_input_context"],
              "properties": {
                "url": { "$ref": "#/$defs/url" },
                "sample_source_url": { "$ref": "#/$defs/url" },
                "app_architectures": { "$ref": "#/$defs/architectures" },
                "opens_input_context": { "const": true }
              }
            },
            "assets": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "required": ["url", "sha256"],
                "properties": {
                  "url": { "$ref": "#/$defs/url" },
                  "sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        "sdk_check": {
          "type": "object",
          "required": ["api", "archive_url", "archive_sha256", "source_url", "source_sha256", "source_file", "archive_member_directory", "header_file", "implementation_file", "link_libraries", "import_library_by_architecture", "runtime_file_by_architecture", "app_architectures", "needs_installed_driver", "opens_input_context", "starts_demo_timer", "expected_without_driver", "expected_after_setup"],
          "properties": {
            "api": { "enum": ["C", "C++17"] },
            "archive_url": { "$ref": "#/$defs/url" },
            "archive_sha256": { "$ref": "#/$defs/sha256" },
            "source_url": { "$ref": "#/$defs/url" },
            "source_sha256": { "$ref": "#/$defs/sha256" },
            "source_file": { "type": "string", "minLength": 1 },
            "archive_member_directory": { "type": "string", "minLength": 1 },
            "header_file": { "type": "string", "minLength": 1 },
            "implementation_file": { "type": ["string", "null"] },
            "link_libraries": { "type": "array", "items": { "type": "string" } },
            "compile_definitions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "description": "Pass these names to target_compile_definitions for the published first check." },
            "import_library_by_architecture": { "type": "object", "additionalProperties": { "type": "string" } },
            "runtime_file_by_architecture": { "type": "object", "additionalProperties": { "type": "string" } },
            "app_architectures": { "$ref": "#/$defs/architectures" },
            "needs_installed_driver": { "type": "boolean" },
            "opens_input_context": { "const": false },
            "starts_demo_timer": { "const": false },
            "expected_without_driver": { "$ref": "#/$defs/checkOutcome" },
            "expected_after_setup": { "$ref": "#/$defs/checkOutcome" }
          }
        }
      }
    },
    "checkOutcome": {
      "type": "object",
      "required": ["exit_code", "output_contains"],
      "properties": {
        "exit_code": { "type": "integer", "minimum": 0 },
        "output_contains": { "type": "string", "minLength": 1 }
      }
    },
    "windowsApp": {
      "type": "object",
      "required": ["id", "name", "tag", "executable", "source", "download_url", "sha256", "executable_sha256", "purpose", "steps", "expected", "needs_input_driver_for_first_run", "test"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "pattern": "\\.exe$" },
        "source": { "$ref": "#/$defs/url" },
        "download_url": { "$ref": "#/$defs/url" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "purpose": { "$ref": "#/$defs/localizedText" },
        "steps": { "$ref": "#/$defs/localizedText" },
        "expected": { "$ref": "#/$defs/localizedText" },
        "directory_listings": {
          "type": "array",
          "description": "Public software-directory entries for this application.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "$ref": "#/$defs/url" }
            },
            "additionalProperties": false
          }
        },
        "needs_input_driver_for_first_run": { "const": false },
        "test": {
          "type": "object",
          "required": ["type", "exit_code"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "exit_code": { "const": 0 },
            "arguments": { "type": "array", "items": { "type": "string" } },
            "source_url": { "$ref": "#/$defs/url" },
            "source_sha256": { "$ref": "#/$defs/sha256" }
          },
          "dependentRequired": { "source_url": ["source_sha256"], "source_sha256": ["source_url"] }
        }
      }
    },
    "registryPackage": {
      "type": "object",
      "required": ["edition", "ecosystem", "name", "version", "package_url", "metadata_url", "install_command", "install_context", "runtime", "architectures", "install_includes_driver_or_application", "first_check"],
      "properties": {
        "edition": { "$ref": "#/$defs/id" },
        "ecosystem": { "enum": ["npm", "pypi", "nuget-managed", "nuget-native", "powershell", "maven", "packagist", "rubygems", "go", "cargo"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "package_url": { "$ref": "#/$defs/url" },
        "metadata_url": { "$ref": "#/$defs/url" },
        "guide_urls": {
          "type": "object",
          "description": "Direct links to this package's row in the English and French installation guides.",
          "required": ["en", "fr"],
          "properties": {
            "en": { "$ref": "#/$defs/url" },
            "fr": { "$ref": "#/$defs/url" }
          },
          "additionalProperties": false
        },
        "documentation_url": { "$ref": "#/$defs/url" },
        "registry_documentation_verified": {
          "const": true,
          "description": "The package registry metadata links to documentation_url."
        },
        "install_command": { "type": "string", "minLength": 1 },
        "install_context": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "architectures": { "$ref": "#/$defs/architectures" },
        "install_includes_driver_or_application": { "const": false },
        "first_check": {
          "type": "object",
          "required": ["call", "expected", "requires_installed_driver", "requires_application", "opens_input_context"],
          "properties": {
            "call": { "type": "string", "minLength": 1 },
            "expected": { "type": "string", "minLength": 1 },
            "requires_installed_driver": { "type": "boolean" },
            "requires_application": { "type": "boolean" },
            "opens_input_context": { "const": false },
            "source_url": { "$ref": "#/$defs/url" },
            "source_sha256": { "$ref": "#/$defs/sha256" },
            "command_from_app_folder": { "type": "string", "minLength": 1 },
            "without_driver_evidence_url": { "$ref": "#/$defs/url" },
            "after_setup_command_from_app_folder": { "type": "string", "minLength": 1 },
            "create_example_project_command": { "type": "string", "minLength": 1 },
            "save_as": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
          },
          "dependentRequired": {
            "source_url": ["source_sha256"],
            "source_sha256": ["source_url"]
          }
        },
        "verified_archive": {
          "type": "object",
          "required": ["sha256"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "url": { "$ref": "#/$defs/url" },
            "filename": { "type": "string", "minLength": 1 }
          },
          "oneOf": [{ "required": ["url"] }, { "required": ["filename"] }]
        }
      },
      "dependentRequired": {
        "registry_documentation_verified": ["documentation_url"]
      }
    }
  }
}
